{
  "name": "python-learning-platform",
  "private": true,
  "version": "1.1.7",
  "type": "module",
  "description": "基于 Python-100-Days 课程的在线互动学习平台",
  "author": "ljher",
  "license": "MIT",
  "homepage": "https://ljher.github.io/Python-100-Days-Web",
  "repository": {
    "type": "git",
    "url": "https://github.com/ljher/Python-100-Days-Web.git"
  },
  "keywords": [
    "python",
    "learning",
    "education",
    "interactive",
    "pyodide",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:github": "vite build && gh-pages -d dist",
    "deploy:vercel": "vite build && vercel --prod",
    "generate-content": "python scripts/fetch_local_content.py",
    "deploy:all": "npm run generate-content && npm run build && echo '构建完成！请选择部署方式：1. npm run deploy:github  2. npm run deploy:vercel'"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.2",
    "katex": "^0.18.1",
    "pyodide": "^314.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^24.0.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
